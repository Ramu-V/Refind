# Copy to .env for local development. NEVER commit a real .env file.

# PostgreSQL connection string. On Render this is injected automatically from the linked database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
# On Render this is generated automatically (render.yaml: generateValue: true).
AUTH_SECRET=

# Optional: "true" loads demo data once, only when the database has zero users.
SEED_DEMO_DATA=false
